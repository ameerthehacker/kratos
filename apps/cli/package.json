{
  "name": "@kratos/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "kratos": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "dev": "tsx watch --clear-screen=false src/index.ts \"${KRATOS_PROJECT:-../..}\" --db \"${KRATOS_DB:-../../.kratos/kratos.db}\" --no-open",
    "build:binary": "node scripts/build-binary.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@kratos/adapter-claude-code": "workspace:*",
    "@kratos/core": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "open": "^11.0.4",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "pino-roll": "^4.0.0",
    "pngjs": "^7.0.0",
    "semver": "^7.8.6",
    "simple-git": "^4.0.2",
    "tar": "^7.5.22",
    "which": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/semver": "^7.8.0",
    "@types/which": "^3.0.4",
    "@types/ws": "^8.18.2",
    "@yao-pkg/pkg": "^6.25.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "pkg": {
    "assets": [
      "drizzle/**/*",
      "../web/dist/**/*",
      "dist/node_modules/better-sqlite3/prebuilds/*.node"
    ],
    "sea": true
  }
}
