{
  "name": "@kratos/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "kratos": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "dev": "tsx watch --clear-screen=false src/index.ts \"${KRATOS_PROJECT:-../..}\" --db \"${KRATOS_DB:-../../.kratos/kratos.db}\""
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@kratos/adapter-claude-code": "workspace:*",
    "@kratos/core": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "open": "^11.0.4",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "pino-roll": "^4.0.0",
    "sharp": "^0.35.5",
    "which": "^7.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/which": "^3.0.4",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
